MigrationBackup/

# Ionide (cross platform F# VS Code tools) working folder
.ionide/

# Fody - auto-generated XML schema
FodyWeavers.xsd

# VS Code files for those working on multiple tools
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# Windows Installer files from build outputs
*.cab
*.msi
*.msix
*.msm
*.msp

# JetBrains Rider
*.sln.iml

# Virtual environment
.venv/

# Packages — vendor wheels: the folder is versioned, its contents are not.
# The pattern has to be `dir/*` and not `dir/`: with the trailing slash git skips the
# directory entirely and the exception below never gets a chance to match.
[Pp]ackages/*
![Pp]ackages/.gitkeep

# Pytest cache
.pytest*/

# Dataset and logger — same as above: the folder is versioned, its contents are not.
data/*
!data/.gitkeep

# Config backup that ConfigManager.save() leaves behind before overwriting.
config.yaml.bak

# Licence of an installation, and the artefacts of the manual test. A .lic is issued per
# machine and is worthless on any other, so versioning one only invites confusion about
# which device it belongs to. The clock state is signed with the machine fingerprint and
# does not travel either.
*.lic
license_request.json
license_state.bin

# Credentials of this installation. The example file IS versioned; the real one never is.
.env
!.env.example

# Key with which a delivered build opens its encrypted model weights. The build generates
# this module and Nuitka compiles it in; it never gets committed, same rule as the private
# signing key. The encrypted weights themselves are not versioned either.
system/inference/models/_model_key.py

# Model weights: large, and versioned outside the repo. `make_release.py` copies the whole
# directory into the deliverable, so it has to exist even in a fork that has no model yet
# — hence the .gitkeep, which `_copy_into()` skips when it copies.
models/*
!models/.gitkeep
*.enc

# Public keys of the delivered build, split into masked fragments. Generated by the
# signing repository right before Nuitka runs and deleted afterwards: it is not a secret,
# but it is per-build, and a committed copy would be a clean constant again.
system/license/_public_key.py

# Weights that the manual test writes next to itself while it runs; it deletes them on
# exit unless --keep is passed. Only the script and its config belong in the repo.
manual_test/model_protection/*
!manual_test/model_protection/check_protected_weights.py
!manual_test/model_protection/config.yaml

# Ruff cache.
.ruff_cache/

# Recorded video that the video_file driver plays as a camera: large, and versioned
# outside the repo, same as the model weights.
recordings/*
!recordings/.gitkeep

# Images the offline-inference manual test reads, and the dated folders it writes. Only
# the script, its config and the empty input folder belong in the repo.
manual_test/offline_inference/images/*
!manual_test/offline_inference/images/.gitkeep
manual_test/offline_inference/output/

# Inputs and outputs of a calibration run: they belong to one commissioning day of one
# plant, and what stays of them is the value they produced, in config.yaml. Each folder
# keeps its .gitkeep, and samples/ keeps a format example. `**` plus the re-included
# directories lets a calibrator split its inputs into subfolders (samples/<kind>/) and
# still keep each one's .gitkeep: git cannot re-include a file under an ignored directory.
calibration/*/samples/**
!calibration/*/samples/**/
!calibration/*/samples/**/.gitkeep
!calibration/*/samples/**/example.*
calibration/*/out/**
!calibration/*/out/**/
!calibration/*/out/**/.gitkeep
